# PORT: The port the server listens on (Cloud Run injects PORT)
PORT=3000

# DATA_PROVIDER: Select persistence layer ('firestore' for Cloud Run / production; 'json' for local/dev fallback)
DATA_PROVIDER=firestore

# FIREBASE CONFIGURATION (For Firebase Authentication & Cloud Firestore)
# Connected Project: mini-ipca-store
# In Google Cloud Run or GCP, Firebase Admin uses Application Default Credentials automatically.
# Values can also be read directly from firebase-applet-config.json
# FIREBASE_PROJECT_ID=mini-ipca-store
# FIRESTORE_DATABASE_ID=(default)
# VITE_FIREBASE_API_KEY=AIzaSyAq4j9RN227_7jplweF-wInsJjemJsjeC4
# VITE_FIREBASE_AUTH_DOMAIN=mini-ipca-store.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=mini-ipca-store
# VITE_FIREBASE_APP_ID=1:52428004141:web:ef0b62d161923f9401d1a4

# INITIAL SEED PASSWORDS (Only read by server/seed-firebase.ts; never hardcoded in frontend or committed)
DEMO_ESTUDIANTE_PASSWORD=
DEMO_DOCENTE_PASSWORD=
DEMO_ADMIN_PASSWORD=
